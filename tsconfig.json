{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./web/*"] },
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "integrations/**/*.ts",
    "scripts/**/*.ts",
    "eslint.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
